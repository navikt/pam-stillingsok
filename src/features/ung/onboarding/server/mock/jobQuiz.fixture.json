                }
            }
        },
        {
            "type": "paragraph--quiz_question",
            "id": "quiz-question-under-18-rules",
            "attributes": {
                "field_question_statement": "Under 18 år gjelder egne regler for hvor mye du kan jobbe.",
                "field_feedback_title": "Egne regler for unge!",
                "field_feedback_content": {
                    "value": "<p>Under 18 kan du jobbe i butikk, restaurant, på lager eller som avisbud. Det er regler for hvor mange timer og hvilke tider du kan jobbe – arbeidsgiver er ansvarlig for å følge disse reglene.</p>",
                    "format": "basic_html"
                },
                "field_read_more_label": "Les mer om dette",
                "source_url": "https://www.arbeidstilsynet.no/arbeidstid-og-organisering/arbeidstid/barn-og-ungdom-i-arbeid/"

                        }
                    ]
                }
            }
        },
        {
            "type": "paragraph--quiz_question",
            "id": "quiz-question-written-contract",
            "attributes": {
                "field_question_statement": "Alle arbeidstakere har rett til en skriftlig arbeidsavtale.",
                "field_feedback_title": "Du har krav på skriftlig avtale!",
                "field_feedback_content": {
                    "value": "<p>En arbeidsavtale skal alltid være skriftlig og inneholde stillingstittel, lønn, arbeidstid og oppsigelsesfrister. Signer aldri noe du ikke forstår – be om tid til å lese gjennom avtalen.</p>",
                    "format": "basic_html"
                },
                "field_read_more_label": "Les mer om dette",
                "source_url": "https://www.arbeidstilsynet.no/arbeidstid-og-organisering/arbeidstid/barn-og-ungdom-i-arbeid/"
            },
            "relationships": {
                "field_quiz_options": {
                    "data": [
                        {
                            "type": "paragraph--quiz_option",
                            "id": "quiz-option-written-contract-true"
                        },
                        {
                            "type": "paragraph--quiz_option",
                            "id": "quiz-option-written-contract-false"
                        }
                    ]
                }
            }
        },
        {
            "type": "paragraph--quiz_question",
            "id": "quiz-question-unlimited-hours",
            "attributes": {
                "field_question_statement": "I Norge kan en arbeidsgiver be deg jobbe ubegrenset mange timer uten ekstra betaling.",
                "field_feedback_title": "Du har krav på overtidsbetaling!",
                "field_feedback_content": {
                    "value": "<p>Normal arbeidstid er 40 timer i uken, men de fleste jobber 37,5 timer. Arbeid utover dette er overtid og skal betales ekstra. Under 18 år gjelder egne og strengere regler for arbeidstid.</p>",
                    "format": "basic_html"
                },
                "field_read_more_label": "Les mer om dette",
                "source_url": "https://www.arbeidstilsynet.no/arbeidstid-og-organisering/arbeidstid/barn-og-ungdom-i-arbeid/"
            },
            "relationships": {
                "field_quiz_options": {
                    "data": [
